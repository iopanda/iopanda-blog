---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${base}/`;
const aboutHref = `${base}/about/`;
---

<BaseLayout title="页面未找到" description="你要找的页面不存在。" noindex>
  <section class="not-found">
    <p class="error-code" aria-hidden="true">404</p>
    <p class="eyebrow">Not found</p>
    <h1>这条路走不通。</h1>
    <p class="lede">页面可能不存在，或者已经被移动到别处。</p>
    <div class="hero-actions">
      <a class="button button--primary" href={homeHref}>
        回到首页 <span aria-hidden="true">→</span>
      </a>
      <a class="button button--ghost" href={aboutHref}>关于我</a>
    </div>
  </section>
</BaseLayout>
