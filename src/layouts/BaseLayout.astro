---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'iopanda 的个人站点：关于代码、工具与日常的安静角落。',
  noindex = false,
} = Astro.props;

const siteName = 'iopanda';
const pageTitle = `${title} · ${siteName}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${base}/`;
const aboutHref = `${base}/about/`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '');
const isHome = normalizedPath === homeHref.replace(/\/+$/, '');
const isAbout = normalizedPath === aboutHref.replace(/\/+$/, '');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#f6f3eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111311" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>

    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={homeHref} aria-label="iopanda 首页">
          <span class="brand-mark" aria-hidden="true">i</span>
          <span>iopanda</span>
        </a>

        <nav class="site-nav" aria-label="主导航">
          <a href={homeHref} aria-current={isHome ? 'page' : undefined}>首页</a>
          <a href={aboutHref} aria-current={isAbout ? 'page' : undefined}>关于</a>
          <a href="https://github.com/iopanda" target="_blank" rel="noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <p>© {year} iopanda</p>
        <p>
          由 <a href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a> 构建 ·
          无追踪
        </p>
      </footer>
    </div>
  </body>
</html>
